{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"],
			"@spacebot/api-client": ["./src/Spacebot/api-client.ts"]
		},
		"types": ["@react-three/fiber"]
	},
	"include": ["src", "src/vite-env.d.ts"]
}
